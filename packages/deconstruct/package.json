{
  "name": "@dukk/doc-repo-deconstruct",
  "version": "0.1.0",
  "description": "Deconstruct existing documents into OKF Markdown packages",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Justin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dukk/doc-repo-tools.git",
    "directory": "packages/deconstruct"
  },
  "bugs": {
    "url": "https://github.com/dukk/doc-repo-tools/issues"
  },
  "homepage": "https://github.com/dukk/doc-repo-tools#readme",
  "bin": {
    "doc-deconstruct": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "pnpm build && node --test dist/**/*.test.js",
    "test:coverage": "pnpm build && c8 --config ../../.c8rc.json node --test dist/**/*.test.js",
    "prepublishOnly": "pnpm test:coverage"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "c8": "^10.1.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
